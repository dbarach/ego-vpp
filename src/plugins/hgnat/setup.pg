comment { simple debug CLI setup script w/ packet generator test vector }
set term page off
loop create mac 00:01:00:02:00:03
set int ip address loop0 1.2.3.4/24
set int state loop0 up
loop create mac 00:04:00:05:00:06
set int ip address loop1 192.168.1.1/24
set int state loop1 up

set interface hgnat in loop1 out loop0

comment { set up 10 sessions }
packet-generator new { name in2out limit 10 size 128-128 interface loop1 node ethernet-input data { IP4: 1.2.3 -> 4.5.6 UDP: 192.168.1.10 - 192.168.1.20 -> 11.22.33.44 UDP: 1234 -> 2345 incrementing 114 } }

comment { out2in traffic on the first session }
packet-generator new { name out2in limit 10 size 128-128 interface loop0 node ethernet-input data { IP4: 4.5.6 -> 1.2.3 UDP: 11.22.33.44 -> 1.2.3.4 UDP: 2345 -> 62303 incrementing 114 } }
