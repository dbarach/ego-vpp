set term pag off

bvi create instance 0
set int l2 bridge bvi0 1 bvi
set int ip address bvi0 192.168.10.1/24
set int state bvi0 up

create tap host-if-name lstack host-ip4-addr 192.168.10.2/24 host-ip4-gw 192.168.10.1
set int l2 bridge tap0 1
set int state tap0 up

echo-server attach
echo-server listen
