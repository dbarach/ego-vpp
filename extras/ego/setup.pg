set term pag off
bin create_loopback
uncomment { ego enable-disable loop0 }
comment { sample macswap loop0 }

packet-generator new {
    name x
    limit 0
    size 128-128
    interface loop0
    node ethernet-input
    data {
        IP6: 01.02.03 -> dead.0.0
        ICMP: db00::1 -> db00::2
        incrementing 30
    }
}
