#! /bin/sh

### BEGIN INIT INFO
# Provides:		bozo
# Required-Start:	$remote_fs $syslog
# Required-Stop:	$remote_fs $syslog
# Default-Start:	2 3 4 5
# Default-Stop:
# Short-Description:	Ban IPs which conduct bozo hack attempts
### END INIT INFO

set -e

. /lib/lsb/init-functions

# Tunnels to Mount Dora

# Are we running from init?
run_by_init() {
    ([ "$previous" ] && [ "$runlevel" ]) || [ "$runlevel" = S ]
}

export PATH="${PATH:+$PATH:}/usr/sbin:/sbin:/usr/local/bin"

case "$1" in
  start)
	log_daemon_msg "Starting Bozo Banner" "bozo" || true
	if start-stop-daemon -c dbarach --start --quiet --oknodo --pidfile /run/bozo.pid --exec /usr/local/bin/ban_bozos -- --daemon ; then
	    log_end_msg 0 || true
	else
	    log_end_msg 1 || true
	fi
	;;
  stop)
	log_daemon_msg "Stopping Bozo Banner" "bozo" || true
	killall ban_bozos
	killall ban_one_bozo
	if start-stop-daemon -c dbarach --stop --quiet --oknodo --pidfile /run/bozo.pid --retry 5; then
	    log_end_msg 0 || true
	else
	    log_end_msg 1 || true
	fi
	;;

  restart)
	start-stop-daemon -c dbarach --stop --quiet --oknodo --retry 30 --pidfile /run/bozo.pid
	killall ban_bozos
	killall ban_one_bozo
	if start-stop-daemon -c dbarach --start --quiet --oknodo --pidfile /run/bozo.pid --exec /usr/local/bin/ban_bozos -- --daemon; then
	    log_end_msg 0 || true
	else
	    log_end_msg 1 || true
	fi
	;;

  status)
	status_of_proc -p /run/bozo.pid ban_bozos && exit 0 || exit $?
	;;

  *)
	log_action_msg "Usage: /etc/init.d/bozo-service {start|stop|reload|force-reload|restart|try-restart|status}" || true
	exit 1
esac

exit 0
