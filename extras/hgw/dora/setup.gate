comment { Old Linksys box yields a constant IP address }
set int mac address GigabitEthernet3/0/0 48:f8:b3:e0:85:1a
set dhcp client intfc GigabitEthernet3/0/0 hostname vppn1
set int state GigabitEthernet3/0/0 up

bvi create instance 0
set int l2 bridge bvi0 1 bvi
set int ip address bvi0 192.168.2.1/24
set int state bvi0 up
 
set int l2 bridge TenGigabitEthernet6/0/0 1
set int state TenGigabitEthernet6/0/0 up 
set int l2 bridge TenGigabitEthernet6/0/1 1
set int state TenGigabitEthernet6/0/1 up 
set int l2 bridge TenGigabitEthernet8/0/0 1
set int state TenGigabitEthernet8/0/0 up 
set int l2 bridge TenGigabitEthernet8/0/1 1
set int state TenGigabitEthernet8/0/1 up 

comment { dhcp server and host-stack access }
create tap host-if-name lstack host-ip4-addr 192.168.2.2/24 host-ip4-gw 192.168.2.1 
set int l2 bridge tap0 1
set int state tap0 up
 
nat44 add interface address GigabitEthernet3/0/0
set interface nat44 in bvi0 out GigabitEthernet3/0/0

nat44 add static mapping local 192.168.2.2 22432 external GigabitEthernet3/0/0 22432 tcp

service restart isc-dhcp-server

comment { nat44 add identity mapping external GigabitEthernet3/0/0 udp 53053 }
comment { bin dns_name_server_add_del 8.8.8.8 }
comment { bin dns_enable_disable }

