comment { This is the test gateway configuration file }
define HOSTNAME vppg2
define TRUNK GigabitEthernet3/0/0

comment { Old Linksys box MAC address yields a constant IP address }
define TRUNK_MACADDR 48:f8:b3:e0:85:1a
define BVI_MACADDR 48:f8:b3:e0:85:1b

comment { inside subnet 192.168.<inside_subnet>.0/24 }

